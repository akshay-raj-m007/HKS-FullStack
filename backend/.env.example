NODE_ENV=development
PORT=4000
HOST=127.0.0.1
PUBLIC_DEMO_MODE=false
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET=
OTP_HASH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_DAYS=7
OTP_PROVIDER=console
PAYMENT_PROVIDER=mock
FRONTEND_URL=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
HOLD_MINUTES=10
AI_ASSISTANT_ENABLED=true
NVIDIA_API_KEY=
# NVIDIA catalog identifiers; run the documented live smoke before enabling.
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Model attempt limit: 1000-18000 ms; overall assistant deadline stays 22000 ms.
NVIDIA_MODEL_TIMEOUT_MS=8500
